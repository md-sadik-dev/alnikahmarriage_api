# Deny direct HTTP access to sensitive internal storage files and directories
<FilesMatch "\.(log|env|json|lock|php|bak|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to internal storage directories
    RewriteRule ^(framework|logs|credentials)(/.*)?$ - [F,L,NC]
    RewriteRule ^app/(backups|private)(/.*)?$ - [F,L,NC]
</IfModule>
