{
  "info": {
    "name": "Al-Nikah Matrimonial - Auth & Profiles APIs",
    "description": "Postman collection for testing Login, Signup/Register, Current User (Me), and Logout APIs for Al-Nikah Matrimonial platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Member Login (Profile ID)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"ALN012\",\n  \"password\": \"Nikah@123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": ["{{base_url}}"],
          "path": ["api", "login"]
        },
        "description": "Login as an existing member using Profile ID or mobile or email."
      }
    },
    {
      "name": "2. Admin Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"Al Nikah\",\n  \"password\": \"720802\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": ["{{base_url}}"],
          "path": ["api", "login"]
        },
        "description": "Login as Admin with username or admin email."
      }
    },
    {
      "name": "3. Sign Up / Register (New Groom or Bride)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mohammad Rizwan\",\n  \"mobile\": \"9876543210\",\n  \"password\": \"Rizwan@123\",\n  \"user_type\": \"GROOM\",\n  \"dob\": \"27 Years\",\n  \"height\": \"5 ft 10 in\",\n  \"complexion\": \"Fair\",\n  \"marital_status\": \"unmarried\",\n  \"religion\": \"Sunni\",\n  \"sect\": \"DEVBANDI\",\n  \"caste\": \"ANSARI\",\n  \"qualification\": \"B.Tech / MBA\",\n  \"work\": \"Software Engineer\",\n  \"income\": \"10 - 15 Lakhs / Annum\",\n  \"native_place\": \"Lucknow, UP\",\n  \"address\": \"Indira Nagar, Lucknow\",\n  \"f_name\": \"Mohd Rashid (Businessman)\",\n  \"m_name\": \"Home Maker\",\n  \"brother\": \"1\",\n  \"sister\": \"2\",\n  \"additional_info\": \"Practicing Muslim, looking for a pious, well-mannered bride from a respectable family.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/signup",
          "host": ["{{base_url}}"],
          "path": ["api", "signup"]
        },
        "description": "Create a new Matrimonial Profile. Generates unique ALN Profile ID and establishes session."
      }
    },
    {
      "name": "4. Check Current User (Me)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/me",
          "host": ["{{base_url}}"],
          "path": ["api", "me"]
        },
        "description": "Get details of currently authenticated user in active session."
      }
    },
    {
      "name": "5. Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/logout",
          "host": ["{{base_url}}"],
          "path": ["api", "logout"]
        },
        "description": "Terminate current session."
      }
    },
    {
      "name": "6. Get All Packages",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/packages",
          "host": ["{{base_url}}"],
          "path": ["api", "packages"]
        },
        "description": "Fetch all active membership packages from database."
      }
    },
    {
      "name": "7. Get Current User Plan & Limits",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/packages/current?profile_id=ALN012",
          "host": ["{{base_url}}"],
          "path": ["api", "packages", "current"],
          "query": [
            { "key": "profile_id", "value": "ALN012" }
          ]
        },
        "description": "Get current active package, validity, and contact limits for user."
      }
    },
    {
      "name": "8. Purchase Package Plan",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"profile_id\": \"ALN012\",\n  \"plan_id\": 2,\n  \"payment_method\": \"UPI / PhonePe\",\n  \"transaction_id\": \"TXN_9876543210\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/packages/purchase",
          "host": ["{{base_url}}"],
          "path": ["api", "packages", "purchase"]
        },
        "description": "Purchase a new package for user. Automatically updates user profile and profile_view_limits."
      }
    },
    {
      "name": "9. Upgrade Package Plan",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"profile_id\": \"ALN012\",\n  \"plan_name\": \"DIAMOND\",\n  \"payment_method\": \"Credit Card / Razorpay\",\n  \"transaction_id\": \"TXN_123456789\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/packages/upgrade",
          "host": ["{{base_url}}"],
          "path": ["api", "packages", "upgrade"]
        },
        "description": "Upgrade an existing plan to higher tier (e.g. Gold -> Diamond) with immediate limit adjustments."
      }
    },
    {
      "name": "10. Get Homepage Banners",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/banners",
          "host": ["{{base_url}}"],
          "path": ["api", "banners"]
        },
        "description": "Fetch active hero banner slides with headlines, images, and CTAs."
      }
    },
    {
      "name": "11. Get Single Banner",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/banners/5",
          "host": ["{{base_url}}"],
          "path": ["api", "banners", "5"]
        },
        "description": "Fetch details of a single banner by ID."
      }
    },
    {
      "name": "12. Get Gallery Photos & Success Stories",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/gallery",
          "host": ["{{base_url}}"],
          "path": ["api", "gallery"]
        },
        "description": "Fetch all success stories and gallery images with image URLs."
      }
    },
    {
      "name": "13. Get Single Gallery Item",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/gallery/8",
          "host": ["{{base_url}}"],
          "path": ["api", "gallery", "8"]
        },
        "description": "Fetch single gallery photo details by ID."
      }
    }
  ]
}
